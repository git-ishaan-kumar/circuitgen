/* CircuitGen Brand Palette and Layout Stylesheet (§2.1, §2.2, §16) */

Screen {
    background: #0D1117;
    color: #E5E7EB;
}

Header {
    background: #161B22;
    color: #4ADE80;
    dock: top;
    height: 1;
}

/* Visually remove the command palette oval icon from the header */
HeaderIcon {
    display: none;
}

Footer {
    background: #161B22;
    color: #9CA3AF;
    dock: bottom;
    height: 1;
}

/* Home Layout Container */
#home-container {
    width: 100%;
    height: 100%;
    align: center top;
    padding-top: 1;
}

#home-card {
    width: 80;
    max-width: 84;
    min-width: 76;
    height: auto;
    background: transparent;
}

.brand-header-row {
    height: 1;
    width: 100%;
}

.brand-title {
    color: #4ADE80;
    text-style: bold;
    dock: left;
    width: auto;
}

.brand-version {
    color: #9CA3AF;
    dock: right;
    width: auto;
}

.tagline {
    color: #9CA3AF;
    margin-bottom: 1;
}

.rule {
    color: #30363D;
    height: 1;
    margin: 0;
}

.prompt-text {
    color: #E5E7EB;
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
}

/* Selectable Menu */
SelectableMenu {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.menu-row {
    height: 1;
    width: 100%;
    padding-left: 2;
}

.menu-row-selected {
    background: #163D2B;
    color: #4ADE80;
    text-style: bold;
}

.menu-chevron {
    width: 2;
    color: #4ADE80;
}

.menu-label {
    width: 14;
    color: #E5E7EB;
    text-style: bold;
}

.menu-row-selected .menu-label {
    color: #4ADE80;
}

.menu-description {
    color: #9CA3AF;
}

.menu-row-selected .menu-description {
    color: #E5E7EB;
}

/* Status Bar Area */
#home-status-row {
    width: 100%;
    height: 1;
    margin-top: 1;
    margin-bottom: 1;
}

.status-left {
    dock: left;
    color: #9CA3AF;
}

.status-right {
    dock: right;
    color: #9CA3AF;
}

.status-accent {
    color: #4ADE80;
}

.status-notice {
    color: #60A5FA;
}

.keys-reminder {
    color: #9CA3AF;
    margin-top: 1;
}

/* Modal Dialog */
QuitModal {
    align: center middle;
}

#quit-dialog {
    width: 60;
    height: auto;
    background: #161B22;
    border: solid #30363D;
    padding: 1 2;
}

.modal-title {
    color: #E5E7EB;
    text-style: bold;
    margin-bottom: 1;
}

.modal-warning {
    color: #9CA3AF;
    margin-bottom: 1;
}

/* Placeholder Screens */
#placeholder-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

#placeholder-card {
    width: 76;
    height: auto;
    background: #161B22;
    border: solid #30363D;
    padding: 2 4;
}

.breadcrumb {
    color: #9CA3AF;
    margin-bottom: 1;
}

.breadcrumb-active {
    color: #4ADE80;
    text-style: bold;
}
