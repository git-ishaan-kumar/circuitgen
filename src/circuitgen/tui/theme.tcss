/* CircuitGen Brand Palette and Layout Stylesheet (§2.1, §2.2, §16) */

Screen {
    background: #0D1117;
    color: #E5E7EB;
}

Header {
    background: #161B22;
    color: #4ADE80;
    dock: top;
    height: 1;
}

/* Visually remove the command palette oval icon from the header */
HeaderIcon {
    display: none;
}

Footer {
    background: #161B22;
    color: #9CA3AF;
    dock: bottom;
    height: 1;
}

/* Home Layout Container */
#home-container {
    width: 100%;
    height: 100%;
    align: center top;
    padding-top: 1;
    overflow-y: auto;
}

#home-card {
    width: 80;
    max-width: 84;
    min-width: 76;
    height: auto;
    background: transparent;
}

.brand-header-row {
    height: 1;
    width: 100%;
}

.brand-title {
    color: #4ADE80;
    text-style: bold;
    dock: left;
    width: auto;
}

.brand-version {
    color: #9CA3AF;
    dock: right;
    width: auto;
}

.tagline {
    color: #9CA3AF;
    margin-bottom: 1;
}

.rule {
    color: #30363D;
    height: 1;
    margin: 0;
}

.prompt-text {
    color: #E5E7EB;
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
}

/* Selectable Menu */
SelectableMenu {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.menu-row {
    height: 1;
    width: 100%;
    padding-left: 2;
}

.menu-row-selected {
    background: #163D2B;
    color: #4ADE80;
    text-style: bold;
}

.menu-chevron {
    width: 2;
    color: #4ADE80;
}

.menu-label {
    width: 14;
    color: #E5E7EB;
    text-style: bold;
}

.menu-row-selected .menu-label {
    color: #4ADE80;
}

.menu-description {
    color: #9CA3AF;
}

.menu-row-selected .menu-description {
    color: #E5E7EB;
}

/* Status Bar Area */
#home-status-row {
    width: 100%;
    height: 1;
    margin-top: 1;
    margin-bottom: 1;
}

.status-left {
    dock: left;
    color: #9CA3AF;
}

.status-right {
    dock: right;
    color: #9CA3AF;
}

.status-accent {
    color: #4ADE80;
}

.status-notice {
    color: #60A5FA;
}

.keys-reminder {
    color: #9CA3AF;
    margin-top: 1;
}

/* Modal Dialogs */
QuitModal, OverwriteModal, CreateDirectoryModal, PathPickerModal {
    align: center middle;
}

#quit-dialog, #overwrite-dialog, #create-dir-dialog {
    width: 62;
    height: auto;
    background: #161B22;
    border: solid #30363D;
    padding: 1 2;
}

#path-picker-dialog {
    width: 76;
    height: auto;
    max-height: 20;
    background: #161B22;
    border: solid #30363D;
    padding: 1 2;
}

.modal-title {
    color: #E5E7EB;
    text-style: bold;
    margin-bottom: 1;
}

.modal-warning {
    color: #9CA3AF;
    margin-bottom: 1;
}

/* JsonEditor and TextArea */
JsonEditor, TextArea {
    background: #0D1117;
    border: solid #30363D;
    color: #E5E7EB;
    height: 12;
}

JsonEditor:focus, TextArea:focus {
    border: solid #4ADE80;
}

/* Placeholder Screens */
#placeholder-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

#placeholder-card {
    width: 76;
    height: auto;
    background: #161B22;
    border: solid #30363D;
    padding: 2 4;
}

.breadcrumb {
    color: #9CA3AF;
    margin-bottom: 1;
}

.breadcrumb-active {
    color: #4ADE80;
    text-style: bold;
}

/* First-Run Setup Screens (§3) */
.breadcrumb-row {
    height: 1;
    width: 100%;
    margin-bottom: 0;
}

.breadcrumb-left {
    color: #4ADE80;
    text-style: bold;
    dock: left;
    width: auto;
}

.breadcrumb-right {
    color: #9CA3AF;
    dock: right;
    width: auto;
}

.setup-title {
    color: #E5E7EB;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.setup-tagline {
    color: #9CA3AF;
    margin-top: 0;
    margin-bottom: 1;
}

/* API Key Input Screen (§3.3) */
.input-field-label {
    color: #E5E7EB;
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
}

#key-input {
    width: 100%;
    margin-top: 0;
    margin-bottom: 1;
    background: #161B22;
    border: solid #30363D;
    color: #E5E7EB;
}

#key-input:focus {
    border: solid #4ADE80;
}

.status-message {
    height: auto;
    color: #60A5FA;
    margin-bottom: 1;
}

.privacy-note {
    color: #6B7280;
    margin-top: 1;
    margin-bottom: 1;
}

/* Setup Complete Summary (§3.5) */
.summary-card {
    height: auto;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
    background: #161B22;
    border: solid #30363D;
    padding: 1 2;
}

.summary-row {
    height: 1;
    width: 100%;
    margin-bottom: 0;
}

.summary-label {
    width: 16;
    color: #9CA3AF;
    text-style: bold;
}

.summary-value {
    color: #4ADE80;
    text-style: bold;
}

/* Validation Results (§6) */
.validation-failed-title {
    color: #F87171;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.error-card {
    height: auto;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
    background: #161B22;
    border: solid #F87171;
    padding: 1 2;
}

.error-text {
    color: #F87171;
    margin-bottom: 0;
}

.warning-text {
    color: #FBBF24;
    margin-bottom: 0;
}

.disclaimer-note {
    color: #9CA3AF;
    text-style: italic;
    margin-top: 1;
    margin-bottom: 0;
}

/* Validation Diagnostics (§6.3) */
#diag-report-container {
    height: auto;
    max-height: 14;
    overflow-y: auto;
    background: #161B22;
    border: solid #30363D;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
}

.diag-section-header {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.diag-error-row {
    color: #F87171;
    margin-bottom: 0;
}

.diag-warning-row {
    color: #FBBF24;
    margin-bottom: 0;
}
