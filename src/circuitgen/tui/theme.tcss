/* CircuitGen Brand Palette and Layout Stylesheet (§2.1, §2.2, §16) */

Screen {
    background: $cg-background;
    color: $cg-text;
}

Header {
    background: $cg-surface;
    color: $cg-accent;
    dock: top;
    height: 1;
}

/* Visually remove the command palette oval icon from the header */
HeaderIcon {
    display: none;
}

Footer {
    background: $cg-surface;
    color: $cg-muted;
    dock: bottom;
    height: 1;
}

/* Home Layout Container */
#home-container {
    width: 100%;
    height: 100%;
    align: center top;
    padding-top: 1;
    overflow-y: auto;
}

#home-card {
    width: 80;
    max-width: 84;
    min-width: 76;
    height: auto;
    background: transparent;
}

.brand-header-row {
    height: 1;
    width: 100%;
}

.brand-title {
    color: $cg-accent;
    text-style: bold;
    dock: left;
    width: auto;
}

.brand-version {
    color: $cg-muted;
    dock: right;
    width: auto;
}

.tagline {
    color: $cg-muted;
    margin-bottom: 1;
}

.rule {
    color: $cg-border;
    height: 1;
    margin: 0;
}

.prompt-text {
    color: $cg-text;
    margin-top: 1;
    margin-bottom: 1;
    text-style: bold;
}

/* Selectable Menu */
SelectableMenu {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.menu-row {
    height: 1;
    width: 100%;
    padding-left: 2;
}

.menu-row-selected {
    background: $cg-selection;
    color: $cg-accent;
    text-style: bold;
}

.menu-chevron {
    width: 2;
    color: $cg-accent;
}

.menu-label {
    width: 14;
    color: $cg-text;
    text-style: bold;
}

.menu-row-selected .menu-label {
    color: $cg-accent;
}

.menu-description {
    color: $cg-muted;
}

.menu-row-selected .menu-description {
    color: $cg-text;
}

/* Status Bar Area */
#home-status-row {
    width: 100%;
    height: 1;
    margin-top: 1;
    margin-bottom: 1;
}

.status-left {
    dock: left;
    color: $cg-muted;
}

.status-right {
    dock: right;
    color: $cg-muted;
}

.status-accent {
    color: $cg-accent;
}

.status-notice {
    color: $cg-info;
}

.keys-reminder {
    color: $cg-muted;
    margin-top: 1;
}

/* Modal Dialogs */
QuitModal, OverwriteModal, CreateDirectoryModal, PathPickerModal {
    align: center middle;
}

#quit-dialog, #overwrite-dialog, #create-dir-dialog, ConfirmSettings .modal-dialog {
    width: 62;
    height: auto;
    background: $cg-surface;
    border: solid $cg-border;
    padding: 1 2;
}

#path-picker-dialog {
    width: 76;
    height: auto;
    max-height: 20;
    background: $cg-surface;
    border: solid $cg-border;
    padding: 1 2;
}

.modal-title {
    color: $cg-text;
    text-style: bold;
    margin-bottom: 1;
}

.modal-warning {
    color: $cg-muted;
    margin-bottom: 1;
}

/* JsonEditor and TextArea */
JsonEditor, TextArea {
    background: $cg-background;
    border: solid $cg-border;
    color: $cg-text;
    height: 12;
}

JsonEditor:focus, TextArea:focus {
    border: solid $cg-accent;
}

/* Placeholder Screens */
#placeholder-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

#placeholder-card {
    width: 76;
    height: auto;
    background: $cg-surface;
    border: solid $cg-border;
    padding: 2 4;
}

.breadcrumb {
    color: $cg-muted;
    margin-bottom: 1;
}

.breadcrumb-active {
    color: $cg-accent;
    text-style: bold;
}

/* First-Run Setup Screens (§3) */
.breadcrumb-row {
    height: 1;
    width: 100%;
    margin-bottom: 0;
}

.breadcrumb-left {
    color: $cg-accent;
    text-style: bold;
    dock: left;
    width: auto;
}

.breadcrumb-right {
    color: $cg-muted;
    dock: right;
    width: auto;
}

.setup-title {
    color: $cg-text;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.setup-tagline {
    color: $cg-muted;
    margin-top: 0;
    margin-bottom: 1;
}

/* API Key Input Screen (§3.3) */
.input-field-label {
    color: $cg-text;
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
}

#key-input {
    width: 100%;
    margin-top: 0;
    margin-bottom: 1;
    background: $cg-surface;
    border: solid $cg-border;
    color: $cg-text;
}

#key-input:focus {
    border: solid $cg-accent;
}

.status-message {
    height: auto;
    color: $cg-info;
    margin-bottom: 1;
}

.privacy-note {
    color: $cg-muted;
    margin-top: 1;
    margin-bottom: 1;
}

/* Setup Complete Summary (§3.5) */
.summary-card {
    height: auto;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
    background: $cg-surface;
    border: solid $cg-border;
    padding: 1 2;
}

.summary-row {
    height: 1;
    width: 100%;
    margin-bottom: 0;
}

.summary-label {
    width: 16;
    color: $cg-muted;
    text-style: bold;
}

.summary-value {
    color: $cg-accent;
    text-style: bold;
}

/* Validation Results (§6) */
.validation-failed-title {
    color: $cg-error;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.error-card {
    height: auto;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
    background: $cg-surface;
    border: solid $cg-error;
    padding: 1 2;
}

.error-text {
    color: $cg-error;
    margin-bottom: 0;
}

.warning-text {
    color: $cg-warning;
    margin-bottom: 0;
}

.disclaimer-note {
    color: $cg-muted;
    text-style: italic;
    margin-top: 1;
    margin-bottom: 0;
}

/* Validation Diagnostics (§6.3) */
#diag-report-container {
    height: auto;
    max-height: 14;
    overflow-y: auto;
    background: $cg-surface;
    border: solid $cg-border;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
}

.diag-section-header {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.diag-error-row {
    color: $cg-error;
    margin-bottom: 0;
}

.diag-warning-row {
    color: $cg-warning;
    margin-bottom: 0;
}

ConfirmSettings {
    align: center middle;
    background: $cg-background 60%;
}

#color-grid {
    width: 24;
    height: 10;
}

#generate-description {
    height: 6;
}

#generate-provider {
    color: $cg-muted;
    margin-top: 1;
}

GenerationProgress {
    background: $cg-background;
}

#generation-progress {
    height: 3;
    width: 100%;
}

ProcessingScreen {
    align: center middle;
    background: $cg-background 60%;
}

#processing-card {
    width: 42;
    height: 7;
    border: solid $cg-accent;
    background: $cg-surface;
    padding: 1 2;
    align: center middle;
}

#processing-message {
    width: 100%;
    height: 1;
    color: $cg-text;
    text-align: center;
}

#processing-indicator {
    width: 100%;
    height: 2;
    color: $cg-accent;
}

.generation-checkpoint {
    width: 1fr;
    height: 3;
    border: solid $cg-border;
    background: $cg-surface;
    color: $cg-muted;
    content-align: center middle;
}

.generation-checkpoint.current {
    border: solid $cg-accent;
    color: $cg-accent;
    text-style: bold;
}

.generation-checkpoint.complete {
    border: solid $cg-accent;
    background: $cg-accent;
    color: $cg-background;
    text-style: bold;
}
